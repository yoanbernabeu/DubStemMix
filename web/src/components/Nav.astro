---
// The site header, the same on the landing page and in the docs.
import { Image } from "astro:assets";
import icon from "../assets/icon.png";
import Led from "./Led.astro";
import { site } from "../site";

interface Props { current?: "home" | "docs" | "compare" }
const { current = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Landing sections, reachable from any page.
const links = [
  ["/#video", "Video"],
  ["/#install", "Install"],
  ["/#features", "Features"],
  ["/#faq", "FAQ"],
  ["/compare/", "Compare"],
];
---
<nav class="sticky top-0 z-20 border-b border-border bg-bg/95 backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href={current === "home" ? "#top" : `${base}/`} aria-label="DubStemMix home" class="flex items-center gap-3">
      <Image src={icon} alt="" width={28} height={28} class="rounded-md" />
      <span class="label-wide hidden text-sm min-[420px]:inline">DubStemMix</span>
    </a>
    <ul class="ml-6 hidden items-center gap-5 md:flex">
      {links.map(([href, label]) => (
        <li><a href={`${base}${href}`} aria-current={current === "compare" && href === "/compare/" ? "page" : undefined} class="label text-[11px] text-dim transition-colors hover:text-cream aria-[current=page]:text-cream">{label}</a></li>
      ))}
    </ul>
    <div class="ml-auto flex items-center gap-4">
      <a href={`${base}/compare/`} aria-current={current === "compare" ? "page" : undefined} class="label text-[11px] text-dim transition-colors hover:text-cream aria-[current=page]:text-cream md:hidden">Compare</a>
      <a
        href={`${base}/docs/`}
        aria-current={current === "docs" ? "page" : undefined}
        class="label rounded border-[1.5px] border-delay px-3 py-1.5 text-[11px] text-delay transition-colors hover:bg-delay hover:text-bg aria-[current=page]:bg-delay aria-[current=page]:text-bg"
      >Docs</a>
      <span class="mono hidden items-center gap-2 text-[11px] text-dim sm:flex"><Led color="reverb" /> v{site.version}</span>
      <a href={site.repo} class="label rounded border-[1.5px] border-border px-3 py-1.5 text-[11px] transition-colors hover:border-cream" rel="noopener">GitHub</a>
    </div>
  </div>
</nav>
