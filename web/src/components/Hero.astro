---
import { Image } from "astro:assets";
import mix from "../assets/screenshots/mix.png";
import Led from "./Led.astro";
import { site } from "../site";
// Tape repeats: each one later and quieter, like the delay's feedback.
const echoes = [0.62, 0.4, 0.25, 0.14, 0.07];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ways = [
  {
    kicker: "01 · the app",
    title: "On your Mac",
    color: "delay",
    text: "The whole studio: split full songs into stems, build your setlists, play them on the MIDImix (or the mouse), record your versions, load your Audio Unit plugins.",
    needs: site.macRequirements,
    links: [{ label: "Install", href: "#install" }, { label: "Docs", href: `${base}/docs/` }],
  },
  {
    kicker: "02 · the plugin",
    title: "On your Akai MPC",
    color: "reverb",
    text: "The same console and effects on the MPC, the MIDImix plugged into it: no computer on stage. The app writes your set on the card, or you copy your stems by hand.",
    needs: site.mpcRequirements,
    links: [{ label: "Download", href: site.mpcDownload }, { label: "How it works", href: "#mpc" }],
  },
  {
    kicker: "03 · the app · alpha",
    title: "On Linux",
    color: "bus3",
    text: "The Mac app's console and studio on a Linux PC, with the same projects. A first version is out: its tests pass, but nobody has played it on a real PC yet.",
    needs: site.linuxRequirements,
    links: [{ label: "Try the alpha", href: "#linux" }, { label: "Docs", href: `${base}/docs/linux/` }],
  },
];
---
<header id="top" class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-4 pt-16 pb-10 sm:px-6 sm:pt-24 sm:pb-14">
    <p class="mono animate-rise text-xs text-dim" style="animation-delay:.05s">
      {site.requirements}
    </p>
    <h1 class="display mt-6 text-[clamp(2.75rem,9vw,7.5rem)]">
      <span class="block animate-rise" style="animation-delay:.15s">Take the stems.</span>
      <span class="block animate-rise" style="animation-delay:.3s">Cut your own</span>
      <span class="flex items-baseline gap-x-[0.3em] overflow-hidden whitespace-nowrap text-delay">
        <span class="animate-rise" style="animation-delay:.45s">dub.</span>
        {echoes.map((o, i) => (
          <span
            class="animate-echo"
            aria-hidden="true"
            style={`--echo-opacity:${o};animation-delay:${0.8 + i * 0.38}s;font-size:${(0.7 - i * 0.12).toFixed(2)}em`}
          >dub.</span>
        ))}
      </span>
    </h1>
    <div class="mt-10 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <p class="animate-rise max-w-2xl text-lg leading-relaxed text-cream/90 sm:text-xl" style="animation-delay:.55s">
        Six stems on six faders, two more to play the effects, the way it was done at King Tubby's: pull the vocal, throw the snare into the echo,
        drop everything but bass and drums, let the spring crash. <strong>No DAW, no session to prepare, nothing to map.</strong>{" "}
        Plug the Akai MIDImix into your Mac or into an Akai MPC, load the stems, play.
      </p>
      <div class="animate-rise flex flex-wrap gap-3" style="animation-delay:.65s">
        <a href={site.repo} rel="noopener" class="label-wide inline-flex h-12 items-center rounded border-[1.5px] border-border px-6 text-sm transition-colors hover:border-cream">Source</a>
      </div>
    </div>

    <!-- One console, three ways to play it: the macOS app, the Akai MPC plugin, the Linux app (alpha). -->
    <div class="animate-rise mt-12 grid gap-px overflow-hidden rounded border-[1.5px] border-border bg-border lg:grid-cols-3" style="animation-delay:.7s">
      {ways.map((w) => (
        <div class="flex flex-col gap-4 bg-bg p-6 sm:p-7">
          <p class="mono text-[11px] text-dim">{w.kicker}</p>
          <h2 class="label-wide flex items-center gap-3 text-xl sm:text-2xl lg:text-xl" style={`color:var(--color-${w.color})`}><Led color={w.color} /> {w.title}</h2>
          <p class="text-sm leading-relaxed text-cream/85">{w.text}</p>
          <p class="mono text-[11px] text-dim">{w.needs}</p>
          <div class="mt-auto flex flex-wrap gap-3 pt-2">
            {w.links.map((l, i) => (
              <a href={l.href} class:list={["label-wide inline-flex h-11 items-center rounded px-5 text-[13px] transition-colors lg:px-4", i === 0 ? "bg-cream text-bg hover:bg-delay" : "border-[1.5px] border-border hover:border-cream"]}>{l.label}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <figure class="animate-rise mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-24" style="animation-delay:.8s">
    <div class="flex items-center gap-3 border-x border-t border-border bg-surface px-4 py-2">
      {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <Led color="delay" on={n !== 4 && n !== 7} />)}
      <span class="mono ml-2 text-[11px] text-dim">MIX · six stem strips · two effect strips</span>
      <span class="mono ml-auto hidden items-center gap-2 text-[11px] text-dim sm:flex"><Led color="reverb" blink /> MIDImix connected</span>
    </div>
    <Image
      src={mix}
      alt="DubStemMix, MIX page: four stem strips with sends to delay, reverb and phaser, the siren and the Syndrum, two effect strips, master column on the right"
      widths={[720, 1100, 1440]}
      sizes="(min-width: 1152px) 1100px, 100vw"
      format="webp"
      loading="eager"
      class="w-full border border-border"
    />
  </figure>
</header>
