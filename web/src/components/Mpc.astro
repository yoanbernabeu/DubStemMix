---
// DubStemMix on an Akai MPC (PRD § 16): the plugin, the export from the app, the docs page.
import { Image } from "astro:assets";
import Section from "./Section.astro";
import Led from "./Led.astro";
import { site } from "../site";
import consoleScreen from "../assets/screenshots/mpc/mpc-console.png";
import songScreen from "../assets/screenshots/mpc/mpc-song.png";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const points = [
  { color: "delay", title: "The same console", text: "Plug the MIDImix into the MPC: sends, dub throws, the effect strips, the siren and the Syndrum, the four pages. The same effects engine, compiled for the MPC." },
  { color: "reverb", title: "One click from the Mac", text: "File ▸ Export Setlist to MPC writes the plugin and the set on the card, from the stems your tunes already use. Unchanged tunes are not copied again." },
  { color: "bus3", title: "A set, no gaps", text: "PLAY START moves on, tunes chain with no silence, the SONG tab cues the next one or plays a tune again. The pads drop, crash and rewind." },
];
---
<Section id="mpc" index="04" title="On an Akai MPC" kicker="the MIDImix plugged into the MPC, no Mac on stage">
  <div class="grid gap-10 lg:grid-cols-[3fr_2fr] lg:gap-14">
    <div class="grid gap-4">
      <div class="overflow-hidden rounded border-[1.5px] border-border">
        <Image src={consoleScreen} alt="DubStemMix on an Akai MPC: the CONSOLE tab, eight strips like the MIDImix" widths={[720, 1100, 1280]} sizes="(min-width: 1152px) 680px, 100vw" format="webp" loading="lazy" class="w-full" />
      </div>
      <div class="overflow-hidden rounded border-[1.5px] border-border">
        <Image src={songScreen} alt="DubStemMix on an Akai MPC: the SONG tab, the setlist with the tune playing and the next one" widths={[720, 1100, 1280]} sizes="(min-width: 1152px) 680px, 100vw" format="webp" loading="lazy" class="w-full" />
      </div>
    </div>
    <div>
      <ul class="grid gap-7">
        {points.map((p) => (
          <li>
            <h3 class="label flex items-center gap-2 text-sm" style={`color:var(--color-${p.color})`}><Led color={p.color} /> {p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-dim">{p.text}</p>
          </li>
        ))}
      </ul>
      <p class="mono mt-8 text-[11px] leading-relaxed text-dim">
        MPC OS 3.10.1 or later. Tested on an MPC One+. Free and open source, like the app, which carries the plugin and
        writes it on the card for you.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`${base}/docs/mpc/`} class="label inline-block rounded border-[1.5px] border-delay px-4 py-2 text-[11px] text-delay transition-colors hover:bg-delay hover:text-bg">Play a set on an MPC →</a>
        <a href={site.mpcDownload} class="label inline-block rounded border-[1.5px] border-cream px-4 py-2 text-[11px] text-cream transition-colors hover:bg-cream hover:text-bg">Download the plugin (.zip)</a>
      </div>
      <p class="mono mt-3 text-[11px] leading-relaxed text-dim">
        No Mac? The plugin works on its own: <a href={`${base}/docs/mpc/#without-the-app`} class="text-cream underline decoration-border underline-offset-4 hover:decoration-cream">put your stems on the card by hand</a>.
      </p>
    </div>
  </div>
</Section>
