---
// Frame of every docs and compare page: header, the list of pages, breadcrumb, table of contents, previous / next.
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { site } from "../site";
import { sections, pagesOf, type SectionKey } from "../sections";

interface Props {
  section: SectionKey;
  title: string;
  seoTitle: string;
  description: string;
  // The page's slug; left out on the section home.
  slug?: string;
  headings?: MarkdownHeading[];
}
const { section, title, seoTitle, description, slug, headings = [] } = Astro.props;
const info = sections[section];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const root = info.root;
const path = slug ? `${root}${slug}/` : root;

const pages = await pagesOf(section);
const index = pages.findIndex((p) => p.id === slug);
const previous = index > 0 ? pages[index - 1] : undefined;
const next = slug ? pages[index + 1] : pages[0];
const toc = headings.filter((h) => h.depth === 2);

const absolute = (p: string) => new URL(`${base}${p}`, Astro.site).href;
const crumbs = [
  { name: site.name, path: "/" },
  { name: info.label, path: root },
  ...(slug ? [{ name: title, path }] : []),
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": slug ? "TechArticle" : "CollectionPage",
      "@id": `${absolute(path)}#page`,
      headline: title,
      name: seoTitle,
      description,
      url: absolute(path),
      inLanguage: "en",
      image: absolute("/og.png"),
      author: { "@type": "Person", name: site.author.name, url: site.author.url },
      about: { "@type": "SoftwareApplication", name: site.name, url: absolute("/"), operatingSystem: "macOS" },
      isPartOf: { "@type": "WebSite", name: site.name, url: absolute("/") },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: absolute(c.path) })),
    },
  ],
};
const href = (p: string) => `${base}${p}`;
---
<Base title={seoTitle} description={description} path={path} jsonLd={jsonLd}>
  <Nav current={section} />

  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[13rem_minmax(0,1fr)] lg:py-14 xl:grid-cols-[13rem_minmax(0,1fr)_12rem]">
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <details id="section-nav" class="group rounded border-[1.5px] border-border lg:border-0">
        <summary class="label cursor-pointer list-none px-4 py-3 text-[11px] text-dim lg:hidden">{info.label} ▾</summary>
        <ol class="grid gap-1 px-4 pb-4 lg:p-0">
          <li>
            <a href={href(root)} aria-current={!slug ? "page" : undefined} class="block border-l-2 border-transparent py-1.5 pl-3 text-sm text-dim hover:text-cream aria-[current=page]:border-delay aria-[current=page]:text-cream">{info.start}</a>
          </li>
          {pages.map((p, i) => (
            <li>
              <a href={href(`${root}${p.id}/`)} aria-current={p.id === slug ? "page" : undefined} class="flex gap-3 border-l-2 border-transparent py-1.5 pl-3 text-sm text-dim hover:text-cream aria-[current=page]:border-delay aria-[current=page]:text-cream">
                {info.numbered && <span class="mono text-[11px] leading-5 text-dim">{String(i + 1).padStart(2, "0")}</span>}{p.data.nav}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </aside>

    <main class="min-w-0">
      <nav aria-label="Breadcrumb"><ol class="mono flex flex-wrap items-center gap-2 text-[11px] text-dim">
        {crumbs.map((c, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true">›</span>}
            {i < crumbs.length - 1 ? <a href={href(c.path)} class="hover:text-cream">{c.name}</a> : <span class="text-cream">{c.name}</span>}
          </li>
        ))}
      </ol></nav>
      <h1 class="display mt-6 text-[clamp(2.25rem,6vw,3.75rem)]">{title}</h1>

      <article class="doc mt-8">
        <slot />
      </article>

      <div class="mt-16 grid gap-4 border-t border-border pt-8 sm:grid-cols-2">
        {previous ? (
          <a href={href(`${root}${previous.id}/`)} class="rounded border-[1.5px] border-border p-4 transition-colors hover:border-cream">
            <span class="label text-[11px] text-dim">← Previous</span>
            <span class="mt-1 block text-cream">{previous.data.nav}</span>
          </a>
        ) : <span />}
        {next && (
          <a href={href(`${root}${next.id}/`)} class="rounded border-[1.5px] border-border p-4 text-right transition-colors hover:border-cream sm:col-start-2">
            <span class="label text-[11px] text-delay">Next →</span>
            <span class="mt-1 block text-cream">{next.data.nav}</span>
          </a>
        )}
      </div>
      {slug && (
        <p class="mono mt-8 text-[11px] text-dim">
          <a href={`${site.repo}/edit/main/web/src/content/${section}/${slug}.md`} rel="noopener" class="hover:text-cream">Edit this page on GitHub</a>
        </p>
      )}
    </main>

    {toc.length > 0 && (
      <nav class="hidden xl:sticky xl:top-24 xl:block xl:self-start" aria-label="On this page">
        <p class="label text-[11px] text-dim">On this page</p>
        <ol class="mt-3 grid gap-2">
          {toc.map((h) => <li><a href={`#${h.slug}`} class="text-[13px] leading-snug text-dim hover:text-cream">{h.text}</a></li>)}
        </ol>
      </nav>
    )}
  </div>
  <Footer />
  <script>
    // The page list is folded on small screens, always open from lg up.
    const nav = document.getElementById("section-nav") as HTMLDetailsElement | null;
    const wide = window.matchMedia("(min-width: 64rem)");
    const sync = () => { if (nav) nav.open = wide.matches; };
    sync();
    wide.addEventListener("change", sync);
  </script>
</Base>
